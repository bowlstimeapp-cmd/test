            }


            return;

        }


        accessSelect.disabled =
            false;


        accessSelect.innerHTML = `

            <option value="">
                Select access areas...
            </option>

        `;


        options.forEach(
            function (optionValue) {

                var option =
                    document.createElement(
                        "option"
                    );


                option.value =
                    optionValue;


                option.textContent =
                    optionValue;


                accessSelect.appendChild(
                    option
                );

            }
        );


        if (options.length === 0) {

            accessSelect.disabled =
                true;


            accessSelect.innerHTML = `

                <option value="">
